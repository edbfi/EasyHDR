{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>edbfi/automation//default.json#v3.0.1"
  ],
  "packageRules": [
    {
      "description": "Update the Slint runtime and build compiler together before resolving their exact shared compiler dependency.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "slint",
        "slint-build"
      ],
      "groupName": "Slint",
      "rangeStrategy": "bump"
    }
  ],
  "automerge": true,
  "platformAutomerge": false,
  "ignoreTests": false,
  "automergeStrategy": "rebase",
  "automergeType": "pr"
}
