{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>edbfi/automation//default.json#v4.1.1",
    "github>edbfi/automation//automerge.json#v4.1.1"
  ],
  "packageRules": [
    {
      "description": "Update the Slint runtime and build compiler together before resolving their exact shared compiler dependency.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "slint",
        "slint-build"
      ],
      "groupName": "Slint",
      "rangeStrategy": "bump"
    }
  ]
}
